# ---- Bắt buộc ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # hoặc publishable key sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # hoặc secret key sb_secret_... (KHÔNG lộ ra client)
APP_URL=http://localhost:3000                   # URL gốc của app (dùng trong tài liệu và hướng dẫn lấy token)
ENCRYPTION_KEY=                                 # 32 byte base64: openssl rand -base64 32
CRON_SECRET=                                    # chuỗi ngẫu nhiên, bảo vệ /api/cron/scheduled

# Tài khoản duy nhất được dùng web app (đăng nhập bằng tên, không cần email)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Phiên bản Graph API của Meta (Facebook/Instagram)
META_GRAPH_VERSION=v23.0
